        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "webhookId": "f6a2c84e-47de-4c35-b693-68ec06495dd3"
    },
    {
      "id": "9ff79eaa-310a-4f11-8b04-698adc39b18d",
      "name": "Customer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        280,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "אתה נציג שירות לקוחות של חנות אלקטרוניקה ישראלית. ענה בעברית, בקצרה ובאדיבות.\n\nכללים:\n- ענה אך ורק על סמך המידע שחוזר מהכלים policies ו-products. אל תמציא.\n- שאלה על מדיניות (החזרות, אחריות, משלוחים, תשלומים, חשבוניות) — השתמש ב-policies.\n- שאלה על מוצר, מחיר או זמינות — השתמש ב-products.\n- אם המידע לא נמצא בכלים, אמור שאין לך את התשובה והצע לפנות לנציג אנושי.\n- אל תיתן ייעוץ משפטי או מס, ואל תבטיח הנחות או חריגות ממדיניות.\n- מחירים בשקלים, כולל מע\"מ."
        }
      },
      "retryOnFail": true,
      "onError": "continueErrorOutput"
    },
