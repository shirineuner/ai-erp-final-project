      "parameters": {
        "content": "WF5 — סוכן שירות לקוחות\n\nבוט טלגרם ללקוחות, מעוגן ב-RAG.\nשולף ממאגרי mypolicies ו-theproducts שמוזנים ב-WF6 ו-WF7.\n\nצריך: credential של טלגרם (בוט הלקוחות) ושל OpenAI.\nחשוב: להריץ את WF6 ו-WF7 לפני, אחרת המאגרים ריקים.",
        "height": 220,
        "width": 480,
        "color": 5
      }
    },
    {
      "id": "55481c8f-c7d2-4ab6-96e4-6c4586785846",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
